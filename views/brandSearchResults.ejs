<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/styles.css">
    <title>Search results</title>
</head>
<body>
    <h4><%= brandTitle %></h4>
    <table>
        <tr>
           
            <th>Model</th>
            <th>Price</th>
        </tr>
        <% brand.forEach(row => { %>
         <tr>
          
            <td><%= row.model %></td>
            <td><%= row.price %></td>
        </tr>
      <%  }) %>
       
    </table>

   
</body>
</html>