<!DOCTYPE html>
<html lang="en">
<head>
     <link rel="stylesheet" href="/styles.css">
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Shoes info</title>
</head>
<body>
    <div>
    <h3><%= shoeTitle %></h3>
   
      
             <table>
                <tr>
                    <th>id</th>
                    
                    <th>Model</th>
                    <th>Price</th>
                    
                </tr>
                  <% shoes.forEach(shoe => { %>
                    <tr>
        <td><%= shoe.id %></td>
       <td><%= shoe.model %></td>
       <td>$<%= shoe.price %></td>
       <td><a href="/<%=shoe.id%>/update/">Update</a></td>
        </tr>
  
<%  }); %>
 </table>
    </div>
    <hr>
     <div>
    <h3><%= brandTitle %></h3>
   
        <% brands.forEach(brand => { %>
             <ul>
       <li><%= brand.name %></li>
   </ul>
<%  }); %>
    </div>
    <hr>
    <h3><%= styleTitle %></h3>
   
        <% styles.forEach(style => { %>
             <ul>
       <li><%= style.style %></li>
   </ul>
<%  }); %>
    </div>
    <hr>
    
    
<%- include("partials/nav") %>
</body>
</html>