<!DOCTYPE html>
<html lang="en">
<head>
     <link rel="stylesheet" href="/styles.css">
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Shoes info</title>
</head>
<body>
    <div>
    <h3><%= shoeTitle %></h3>
   
      
             <table>
                <tr>
                    <th>id</th>
                    
                    <th>Model</th>
                    <th>Style</th>
                    <th>Price</th>
                    
                </tr>
                  <% shoes.forEach(shoe => { %>
                    <tr>
        <td><%= shoe.id %></td>
       <td><%= shoe.model %></td>
       <td><%= shoe.style %></td>
       <td>$<%= shoe.price %></td>
       <td><a href="/<%=shoe.id%>/update/">Update</a></td>
       <td><form action="/<%=shoe.id%>/deleteShoe/", method="POST">
        <button type="submit" onclick="return confirm('Really delete this shoe?')">Delete shoe!</button>
       </form></td>
        </tr>
  
<%  }); %>
 </table>
    </div>
    <hr>
     <div>
    <h3><%= brandTitle %></h3>
   <table>
        <% brands.forEach(brand => { %>
            <tr>
       <td><%= brand.name %></td>
       <td><form action="/<%=brand.id%>/deleteBrand" method="POST">
        <button type="submit" onclick="return confirm('Delete brand?')">Delete brand</button>
       </form></td>
   </tr>
<%  }); %>
</table>
    </div>
    <hr>
    <h3><%= styleTitle %></h3>
   <table>
        <% styles.forEach(style => { %>
             <tr>
       <td><%= style.style %></td>
       <td><form action="/<%=style.id%>/deleteStyle" method="POST">
        <button type="submit" onclick="return confirm('Delete style?')">Delete Style</button>
       </form></td>
   </tr>
<%  }); %>
</table>
    </div>
    <hr>
    
    
<%- include("partials/nav") %>
</body>
</html>