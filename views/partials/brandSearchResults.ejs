
    <% if(brand != undefined) { %>
    <div>
    <h4><%= brandTitle %></h4>
    <table>
        <tr>
           
            <th>Model</th>
            <th>Price</th>
        </tr>
        <% brand.forEach(row => { %>
         <tr>
          
            <td><%= row.model %></td>
            <td><%= row.price %></td>
        </tr>
      <%  }) %>
       
    </table>

   </div>
   <% }  %>
