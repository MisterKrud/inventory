
    <% if (style != undefined) { %>
   <div>
     <h4><%= styleTitle %></h4>
    <table>
        <tr>
           
            <th>Model</th>
            <th>Price</th>
        </tr>
        <% style.forEach(row => { %>
         <tr>
          
            <td><%= row.model %></td>
            <td><%= row.price %></td>
        </tr>
      <%  }) %>
       
    </table>
    </div>
    <% } %>
